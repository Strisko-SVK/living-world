DATABASE_URL=postgresql://living_world:living_world@localhost:5432/living_world
POSTGRES_DB=living_world
POSTGRES_USER=living_world
POSTGRES_PASSWORD=living_world

# Opt in only after configuring mappings and the bot's Message Content intent.
DISCORD_ENABLED=false
# NPC intake defaults to disabled in the database; enable contexts via the local CLI.
# DISCORD_TOKEN=replace-with-your-bot-token-in-local-env
DISCORD_INTENTS=Guilds,GuildMessages,MessageContent

# No generation at startup. Disabled unless all required LLM settings are valid.
LLM_PROVIDER=disabled
# OPENAI_API_KEY: set privately in .env; never commit or log it.
# LLM_MODEL: set to the exact model covered by your verified pricing.
LLM_TIMEOUT_MS=30000
LLM_MAX_OUTPUT_TOKENS=512
LLM_MAX_ATTEMPTS=2
# Required when enabled: USD or EUR. Both currencies MUST match; no FX conversion.
# LLM_CURRENCY=
# LLM_PRICE_CURRENCY=
# Integer micro-units (1,000,000 = one reporting currency unit).
# Choose a small LLM-only ceiling; infrastructure is outside this ledger.
# LLM_MONTHLY_BUDGET_MICROS=
# LLM_REQUEST_BUDGET_MICROS=
# Verified standard-tier input/output prices, micro-units per MILLION tokens.
# LLM_INPUT_MICROS_PER_MILLION=
# LLM_OUTPUT_MICROS_PER_MILLION=
