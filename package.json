{
  "name": "living-world",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier src/offline/npc-post-inbound.ts && prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node --env-file=.env.example --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --config vitest.db.config.ts",
    "db:generate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs studio",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "prepare": "husky",
    "quality:gate": "pnpm test:security && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "admin:context-policy": "node --env-file-if-exists=.env --import tsx src/admin/context-intake-policy.ts",
    "admin:deliver": "node --env-file-if-exists=.env --import tsx src/admin/discord-delivery.ts",
    "db:init": "node scripts/security/init-local-env.mjs",
    "test:security": "node --test scripts/security/security.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.12",
    "vite": "^7.3.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": "prettier --write"
  },
  "private": true,
  "dependencies": {
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.3",
    "openai": "^7.38.0",
    "pg": "^8.23.0",
    "zod": "^4.6.6"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils@3.3.2>esbuild": "0.25.12",
      "source-map-js@<1.2.2": "1.2.2",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1"
    }
  }
}
