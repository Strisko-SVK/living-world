# Installation target: /etc/living-world/llama.env, root-owned mode 0600.
# Operator selects a model; a restart is required to switch safely.
# One model process on the 4-vCPU, ~8-GiB ARM host.
LW_LLAMA_MODEL=unsloth/Qwen3.5-4B-GGUF:Q4_K_M
LW_LLAMA_ALIAS=Qwen3.5-4B
LW_LLAMA_CONTEXT=4096
LW_LLAMA_THREADS=4
LW_LLAMA_BATCH_THREADS=4
LW_LLAMA_PARALLEL=1
LW_LLAMA_TEMPERATURE=0.7
LW_LLAMA_TOP_P=0.8
LW_LLAMA_TOP_K=20
LW_LLAMA_MIN_P=0
LW_LLAMA_PRESENCE_PENALTY=1.5
LW_LLAMA_THINKING=false
LW_LLAMA_NO_MMPROJ=true
